# Supabase PostgreSQL Database Connection
# Use the transaction pooler connection string (port 6543) or direct connection:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase Auth & Client API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# App & Deployment URLs
NEXT_PUBLIC_SITE_URL="https://sakanajp.site"

# Cloudflare R2 Storage (Audio & Media)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="japanese-learning-media"
# Public URL (custom domain or *.r2.dev URL) for accessing uploaded audio/media files
NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.sakanajp.site"
